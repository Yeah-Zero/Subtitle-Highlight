{
	"schemaVersion": 1,
	"id": "subtitle_highlight",
	"version": "${version}",
	"name": "Subtitle Highlight",
	"description": "为不同字幕添加样式以区分，同时提供对单个字幕的自定义设置。",
	"authors": [
		"Yeah-Zero",
		"Qituo",
		"Yifei"
	],
	"contact": {
		"homepage": "https://github.com/Yeah-Zero/Subtitle-Highlight",
		"issues": "https://github.com/Yeah-Zero/Subtitle-Highlight/issues"
	},
	"license": "LGPL-3.0",
	"icon": "assets/subtitle_highlight/textures/gui/logo.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"Yeah_Zero.Subtitle_Highlight.Initializer"
		],
		"modmenu": [
			"Yeah_Zero.Subtitle_Highlight.Configure.ScreenAPI"
		]
	},
	"mixins": [
		{
			"config": "subtitle_highlight.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"cloth-config": "*",
		"fabricloader": ">=0.18.5",
